# Public origin used for canonical URLs and structured data. No trailing slash.
# Leave empty to use the documented company website.
AMESCOM_SITE_URL=

# Content publication gate. preview (default) | production
# production emits only pages marked public.
AMESCOM_CONTENT_MODE=

# Search indexing. Keep unset or anything other than "public".
# Indexing also requires production content mode and a public privacy notice (Q31).
AMESCOM_INDEXING=

# Form destination. Allowed values: mock | disabled
# mock = local/test acceptance only (development default)
# disabled = production default until Q09 names a real provider
# Do not set a live provider name or invent an API endpoint.
AMESCOM_FORM_MODE=

# Reserved names for a future provider (Q09). Leave empty.
# Do not put real secrets in this file.
# AMESCOM_FORM_PROVIDER=
# AMESCOM_FORM_API_KEY=
# AMESCOM_FORM_FROM=
# AMESCOM_FORM_TO=

# Optional rate-limit overrides for local testing.
# AMESCOM_FORM_RATE_LIMIT_WINDOW_MS=60000
# AMESCOM_FORM_RATE_LIMIT_MAX=5
